<?xml version="1.0"?>
<ruleset name="QMDB">
    <description>QMDB PSR-12 coding standard.</description>

    <file>src</file>
    <file>tests</file>
    <file>public</file>
    <file>routes</file>
    <file>database</file>
    <file>tools</file>
    <file>bin/console</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <exclude-pattern>vendor/*</exclude-pattern>

    <rule ref="PSR12"/>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tools/bootstrap.php</exclude-pattern>
    </rule>
</ruleset>
