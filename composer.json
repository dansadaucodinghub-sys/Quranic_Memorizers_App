{
  "name": "quran-memorizer/qmdb",
  "description": "Core PHP foundation for the Qur’an Memorizer DB platform.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-mbstring": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Qmdb\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Qmdb\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "analyse": "php vendor/bin/phpstan analyse --configuration phpstan.neon.dist --no-progress",
    "cs:check": "php vendor/bin/phpcs --standard=phpcs.xml.dist",
    "cs:fix": "php vendor/bin/phpcbf --standard=phpcs.xml.dist",
    "security:audit": "@composer audit --locked",
    "autoload:check": "@composer dump-autoload --strict-psr",
    "quality": [
      "@composer validate --strict",
      "@security:audit",
      "@autoload:check",
      "@cs:check",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "platform-check": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
