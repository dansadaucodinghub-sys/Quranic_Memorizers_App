{
  "name": "quran-memorizer/qmdb",
  "description": "Core PHP foundation for the Qur’an Memorizer DB platform.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-sodium": "*",
    "dompdf/dompdf": "3.1.6",
    "endroid/qr-code": "^6.1",
    "monolog/monolog": "^3.10",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "psr/container": "^2.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0",
    "spomky-labs/otphp": "^11.5",
    "symfony/mailer": "^8.1",
    "vlucas/phpdotenv": "^5.6",
    "web-auth/webauthn-lib": "^5.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Qmdb\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Qmdb\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite Quality",
    "test:mysql": "php tools/Ci/run-mysql-tests.php",
    "analyse": "php vendor/bin/phpstan analyse --configuration phpstan.neon.dist --no-progress --memory-limit=1G",
    "cs:check": "php vendor/bin/phpcs --standard=phpcs.xml.dist --warning-severity=0",
    "cs:fix": "php vendor/bin/phpcbf --standard=phpcs.xml.dist",
    "security:audit": "@composer audit --locked",
    "autoload:check": "@composer dump-autoload --strict-psr",
    "frontend:install": "npm ci --ignore-scripts",
    "frontend:quality": "npm run quality",
    "ci:repository": "php tools/ci/verify-repository.php",
    "ci:frozen": "php tools/ci/verify-frozen-baseline.php",
    "ci:workflows": "php tools/ci/verify-workflows.php",
    "ci:links": "php tools/ci/verify-markdown-links.php",
    "ci:lockfiles": "php tools/ci/verify-lockfiles.php",
    "ci": "php tools/ci/run-local-ci.php",
    "sbom:generate": "php tools/sbom/generate-production-sbom.php",
    "sbom:validate": "php tools/sbom/validate-sbom.php",
    "licences:generate": "php tools/sbom/generate-runtime-licences.php",
    "release:build": "php tools/build/build-release.php",
    "release:verify": "php tools/build/verify-release.php",
    "closeout:freeze:generate": "php tools/Closeout/generate-engineering-freeze.php",
    "closeout:freeze:verify": "php tools/Closeout/verify-engineering-freeze.php",
    "closeout:p2-freeze:generate": "php tools/Closeout/generate-p2-freeze.php",
    "closeout:p2-freeze:verify": "php tools/Closeout/verify-p2-freeze.php",
    "quality": [
      "@composer validate --strict",
      "@security:audit",
      "@autoload:check",
      "@cs:check",
      "@analyse",
      "@test",
      "@frontend:quality"
    ]
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "platform-check": true,
    "process-timeout": 7200,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
