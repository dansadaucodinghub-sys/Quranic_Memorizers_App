#!/usr/bin/env php
<?php

declare(strict_types=1);

use Qmdb\Bootstrap\ApplicationFactory;
use Qmdb\Bootstrap\Error\BootstrapSupport;
use Qmdb\Bootstrap\RuntimeRequirements;
use Qmdb\Bootstrap\Shared\ExitCode;
use Qmdb\Shared\Configuration\ConfigurationException;

$root = dirname(__DIR__);
require_once $root . '/src/Bootstrap/Error/BootstrapSupport.php';
$fallback = BootstrapSupport::failureResponder();

try {
    $runtimeResult = (new RuntimeRequirements())->evaluateCurrentRuntime();

    if (!$runtimeResult->isSatisfied()) {
        $failure = $fallback->create('runtime_requirements');
        fwrite(STDERR, $runtimeResult->toCliString() . "\nReference: " . $failure->requestId() . "\n");
        exit(ExitCode::FAILURE->value);
    }

    require_once $root . '/vendor/autoload.php';

    $console = ApplicationFactory::fromCurrentProcess($root)->createConsoleApplication();
    $result = $console->run(array_slice($argv, 1));

    if ($result->standardOutput() !== '') {
        fwrite(STDOUT, $result->standardOutput());
    }

    if ($result->standardError() !== '') {
        fwrite(STDERR, $result->standardError());
    }

    exit($result->exitCode()->value);
} catch (ConfigurationException $exception) {
    $failure = $fallback->create('configuration');
    fwrite(STDERR, $exception->toCliString() . "\nReference: " . $failure->requestId() . "\n");
    exit(ExitCode::FAILURE->value);
} catch (Throwable) {
    $failure = $fallback->create('unexpected_throwable');
    fwrite(STDERR, "The operation could not be completed.\nReference: " . $failure->requestId() . "\n");
    exit(ExitCode::FAILURE->value);
}
