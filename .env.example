# Copy this file to .env only for local development when desired.
# .env is ignored by Git. Staging and production must use externally injected configuration.
# Never commit secrets. Future secret names are added only by their owning implementation batches.

APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOG_LEVEL=info
APP_PUBLIC_BASE_URL=http://127.0.0.1:8080

AUTH_CSRF_SIGNING_KEY=
AUTH_IDENTITY_HMAC_KEY=
AUTH_CONTACT_ENCRYPTION_KEY=
AUTH_CONTACT_ENCRYPTION_KEY_ID=local-v1
AUTH_CSRF_TTL_SECONDS=1800
AUTH_FORM_MAX_BYTES=16384
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_BYTES=1024
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=1800
AUTH_EMAIL_VERIFICATION_MAX_ATTEMPTS=5
AUTH_REGISTRATION_WINDOW_SECONDS=900
AUTH_REGISTRATION_MAX_ATTEMPTS=5
AUTH_VERIFICATION_RESEND_WINDOW_SECONDS=900
AUTH_VERIFICATION_RESEND_MAX_ATTEMPTS=3
AUTH_PASSWORD_WINDOW_SECONDS=900
AUTH_PASSWORD_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_SESSION_IDLE_TTL_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=43200
AUTH_SESSION_ROTATION_INTERVAL_SECONDS=900
AUTH_SESSION_PREVIOUS_TOKEN_GRACE_SECONDS=30
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=60
AUTH_SESSION_MAX_ACTIVE_PER_ACCOUNT=10
AUTH_DEVICE_COOKIE_TTL_SECONDS=31536000
AUTH_PASSWORD_RECOVERY_TTL_SECONDS=1800
AUTH_PASSWORD_RECOVERY_MAX_ATTEMPTS=5
AUTH_PASSWORD_RECOVERY_REQUEST_WINDOW_SECONDS=900
AUTH_PASSWORD_RECOVERY_REQUEST_MAX_ATTEMPTS=3
AUTH_PASSWORD_RECOVERY_CONFIRM_WINDOW_SECONDS=900
AUTH_PASSWORD_RECOVERY_CONFIRM_MAX_ATTEMPTS=10
AUTH_SECURITY_NOTIFICATION_BATCH_SIZE=25
AUTH_SECURITY_NOTIFICATION_MAX_ATTEMPTS=5
AUTH_SECURITY_NOTIFICATION_LEASE_SECONDS=120
AUTH_SECURITY_NOTIFICATION_RETRY_BASE_SECONDS=60
AUTH_SECURITY_NOTIFICATION_RETRY_MAX_SECONDS=3600

AUTH_TRANSACTION_TTL_SECONDS=300
AUTH_TRANSACTION_MAX_ATTEMPTS=5
AUTH_STEP_UP_GRANT_TTL_SECONDS=300
AUTH_STEP_UP_MAX_ATTEMPTS=5
AUTH_MFA_ENCRYPTION_KEY=
AUTH_MFA_ENCRYPTION_KEY_VERSION=1
AUTH_TOTP_ISSUER=Quran Memorizer DB
AUTH_TOTP_PERIOD_SECONDS=30
AUTH_TOTP_DIGITS=6
AUTH_TOTP_ALLOWED_DRIFT_STEPS=1
AUTH_TOTP_ENROLLMENT_TTL_SECONDS=600
AUTH_RECOVERY_CODE_COUNT=10
AUTH_RECOVERY_CODE_BYTES=16
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_RP_NAME=Quran Memorizer DB
AUTH_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:8080
AUTH_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
AUTH_WEBAUTHN_MAX_RESPONSE_BYTES=65536
AUTH_WEBAUTHN_USER_VERIFICATION=required
AUTH_WEBAUTHN_ATTESTATION=none
AUTH_WEBAUTHN_PASSWORDLESS_ENABLED=true
AUTH_MFA_WINDOW_SECONDS=900
AUTH_MFA_MAX_ATTEMPTS=10
AUTH_PASSKEY_WINDOW_SECONDS=900
AUTH_PASSKEY_MAX_ATTEMPTS=20

# Controlled privileged access. Values are bounded and validated at bootstrap.
AUTH_PRIVILEGED_ACCESS_REQUEST_TTL_SECONDS=86400
AUTH_TEMPORARY_PRIVILEGE_MAX_TTL_SECONDS=14400
AUTH_SUPPORT_ACCESS_MAX_TTL_SECONDS=7200
AUTH_BREAK_GLASS_MAX_TTL_SECONDS=900
AUTH_PRIVILEGED_ACCESS_MAX_PERMISSIONS=16
AUTH_PRIVILEGED_ACCESS_REVIEW_TTL_SECONDS=86400
AUTH_PRIVILEGED_ACCESS_JUSTIFICATION_MAX_BYTES=2000
AUTH_PRIVILEGED_ACCESS_REFERENCE_MAX_BYTES=128
AUTH_PRIVILEGED_ACCESS_MAINTENANCE_BATCH_SIZE=50
AUTH_PRIVILEGED_ACCESS_REQUEST_WINDOW_SECONDS=900
AUTH_PRIVILEGED_ACCESS_REQUEST_MAX_ATTEMPTS=10
AUTH_BREAK_GLASS_WINDOW_SECONDS=3600
AUTH_BREAK_GLASS_MAX_ATTEMPTS=3

# Security Audit and Account State (P2-B09)
AUTH_SECURITY_AUDIT_HMAC_KEY=
AUTH_SECURITY_AUDIT_HMAC_KEY_VERSION=1
AUTH_SECURITY_AUDIT_METADATA_MAX_BYTES=4096
AUTH_SECURITY_AUDIT_VERIFY_BATCH_SIZE=1000
AUTH_SECURITY_AUDIT_CHECKPOINT_INTERVAL_SECONDS=3600
AUTH_SECURITY_AUDIT_CHECKPOINT_MAX_STREAMS=10000
AUTH_ACCOUNT_STATE_JUSTIFICATION_MAX_BYTES=2000
AUTH_ACCOUNT_STATE_REFERENCE_MAX_BYTES=128
AUTH_ACCOUNT_STATE_WINDOW_SECONDS=900
AUTH_ACCOUNT_STATE_MAX_ATTEMPTS=10

MAILER_DSN=smtp://127.0.0.1:1025
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME=Qur’an Memorizer DB

WORKER_MAX_JOBS=100
WORKER_MAX_RUNTIME_SECONDS=300
WORKER_IDLE_SLEEP_MS=1000
WORKER_MAX_MEMORY_MB=128
WORKER_REQUIRE_PCNTL_IN_PRODUCTION=true

SCHEDULER_RUN_LEASE_SECONDS=300
SCHEDULER_LOCK_TIMEOUT_SECONDS=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qmdb
DB_USERNAME=qmdb_app
DB_PASSWORD=
DB_TLS_MODE=disabled
DB_TLS_CA_FILE=
DB_CONNECT_TIMEOUT_SECONDS=5
DB_DEADLOCK_MAX_ATTEMPTS=3
DB_DEADLOCK_BASE_DELAY_MS=25
DB_DEADLOCK_MAX_DELAY_MS=250

# Required only for operational schema commands. Must be distinct from DB_USERNAME.
DB_SCHEMA_USERNAME=qmdb_migrator
DB_SCHEMA_PASSWORD=
DB_SCHEMA_LOCK_TIMEOUT_SECONDS=30
