# Copy this file to .env only for local development when desired.
# .env is ignored by Git. Staging and production must use externally injected configuration.
# Never commit secrets. Future secret names are added only by their owning implementation batches.

APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOG_LEVEL=info

WORKER_MAX_JOBS=100
WORKER_MAX_RUNTIME_SECONDS=300
WORKER_IDLE_SLEEP_MS=1000
WORKER_MAX_MEMORY_MB=128
WORKER_REQUIRE_PCNTL_IN_PRODUCTION=true

SCHEDULER_RUN_LEASE_SECONDS=300
SCHEDULER_LOCK_TIMEOUT_SECONDS=1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qmdb
DB_USERNAME=qmdb_app
DB_PASSWORD=
DB_TLS_MODE=disabled
DB_TLS_CA_FILE=
DB_CONNECT_TIMEOUT_SECONDS=5
DB_DEADLOCK_MAX_ATTEMPTS=3
DB_DEADLOCK_BASE_DELAY_MS=25
DB_DEADLOCK_MAX_DELAY_MS=250

# Required only for operational schema commands. Must be distinct from DB_USERNAME.
DB_SCHEMA_USERNAME=qmdb_migrator
DB_SCHEMA_PASSWORD=
DB_SCHEMA_LOCK_TIMEOUT_SECONDS=30
